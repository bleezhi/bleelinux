# bleelinux kernel tweaks on top of x86_64_defconfig + minimal.config
CONFIG_CMDLINE="console=ttyS0,115200n8"
CONFIG_CMDLINE_FORCE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NVME_CORE=y
CONFIG_NVME=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_TMPFS=y
# no BTF in Phase 1 (avoids pahole dep)
# CONFIG_DEBUG_INFO_BTF is not set
