# Minimal base: virtio, nvme, ext4/overlayfs/btrfs, iptables/nftables, cgroupv2
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_NAMESPACES=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NVME_CORE=y
CONFIG_NVME=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NF_TABLES=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_BLK_DEV_INITRD=y
